   "out": "'@x"
  },
  {
   "v": "line\nbreak",
   "out": "\"line\nbreak\""
  },
  {
   "v": null,
   "out": ""
  },
  {
   "v": "__undef__",
   "out": ""
  },
  {
   "v": 0,
   "out": "0"
  },
  {
   "v": "\tTab",
   "out": "'\tTab"
  }
 ],
 "toCSV": [
